# App Settings
APP_NAME="PDF Extraction Backend"
DEBUG=false

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=temp_uploads

# OCR Settings
TESSERACT_CMD=  # Leave empty for auto-detect, or specify path like /usr/bin/tesseract
OCR_LANGUAGE=eng  # Tesseract language code (eng, fra, deu, etc.)

# API Settings
API_V1_PREFIX=/api/v1
